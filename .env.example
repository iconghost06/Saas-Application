# Database Configuration
DATABASE_URL=postgresql://saas_user:saas_password@localhost:5432/saas_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Stripe (Test Mode) - Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email (Mailtrap Sandbox SMTP) - Get from https://mailtrap.io
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username_here
SMTP_PASS=your_mailtrap_password_here
EMAIL_FROM=SaaS Analytics Platform <noreply@saasplatform.com>

# Application Config
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
